PORT=8080
NODE_ENV=development

# Session secret - change this in production!
SESSION_SECRET=change_this_to_a_very_long_random_secret_string_in_production

# CORS - your frontend URL
CORS_ORIGIN=http://localhost:3000

# Optional: Global SMTP for notifications (separate from user SMTP configs)
# NOTIFICATION_SMTP_HOST=smtp.gmail.com
# NOTIFICATION_SMTP_PORT=587
# NOTIFICATION_SMTP_SECURE=false
# NOTIFICATION_SMTP_USER=your@gmail.com
# NOTIFICATION_SMTP_PASS=your_app_password
# NOTIFICATION_FROM_NAME=Email Campaign Notifications
